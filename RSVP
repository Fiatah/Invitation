        </div>
    </section>

    <!-- FAQ -->
    <section class="section-container">
        <h2 class="section-title">Questions Fréquentes</h2>

        <div class="faq-item">
            <div class="faq-question">Les enfants sont-ils invités ? <span>+</span></div>
            <div class="faq-answer">Pour nous permettre de célébrer cet événement en toute sérénité, la soirée sera réservée aux adultes.</div>
        </div>

        <div class="faq-item">
            <div class="faq-question">Quelle est la date limite pour le RSVP ? <span>+</span></div>
            <div class="faq-answer">Merci de nous confirmer votre présence avant le 30 Novembre.</div>
        </div>

        <div class="faq-item">
            <div class="faq-question">La cérémonie et la réception ont-elles lieu au même endroit ? <span>+</span></div>
            <div class="faq-answer">Oui, l'ensemble des festivités se déroulera au même domaine.</div>
        </div>
    </section>

    <!-- Formulaire RSVP -->
    <section class="rsvp-section" id="rsvp">
        <h2 class="section-title">RSVP</h2>
        <p>Merci de nous indiquer votre présence avant le 30 Novembre</p>
        
        <form id="rsvp-form">
            <input type="text" placeholder="Nom & Prénom" required>
            <select required>
                <option value="" disabled selected>Serez-vous présent ?</option>
                <option value="oui">Oui, avec plaisir !</option>
                <option value="non">Non, je ne pourrai pas être présent(e)</option>
            </select>
            <input type="number" placeholder="Nombre d'accompagnants" min="0" max="5">
            <textarea placeholder="Régime alimentaire particulier / Allergies" rows="3"></textarea>
            <button type="submit" class="btn-rsvp">Envoyer la réponse</button>
        </form>
    </section>

    <footer>
        Steve & Keren — 13.09.2026
    </footer>

