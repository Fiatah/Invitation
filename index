
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invitation de Mariage</title>
  <link rel="preconnect" href="[https://fonts.googleapis.com](https://fonts.googleapis.com)">
  <link rel="preconnect" href="[https://fonts.gstatic.com](https://fonts.gstatic.com)" crossorigin>
  <link href="[https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Montserrat:wght@300;400;500&display=swap](https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600&family=Montserrat:wght@300;400;500&display=swap)" rel="stylesheet">
  
  <style>
    :root {
      --bg-color: #fcfbf9;
      --card-bg: #ffffff;
      --text-main: #2b2b2b;
      --text-muted: #666666;
      --accent: #d4a373;
      --accent-hover: #bc8a5f;
      --border: #e8e6e1;
      --font-title: 'Cormorant Garamond', serif;
      --font-body: 'Montserrat', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: var(--font-body);
      line-height: 1.6;
      text-align: center;
    }

    section {
      padding: 60px 20px;
      max-width: 900px;
      margin: 0 auto;
    }

    h1, h2, h3 {
      font-family: var(--font-title);
      font-weight: 400;
      letter-spacing: 1px;
    }

    h2 {
      font-size: 2.2rem;
      margin-bottom: 25px;
      position: relative;
    }

    h2::after {
      content: '';
      display: block;
      width: 40px;
      height: 1px;
      background: var(--accent);
      margin: 15px auto 0;
    }

    /* Hero Section */
    .hero {
      padding-top: 100px;
      padding-bottom: 60px;
    }

    .hero h1 {
      font-size: 3.5rem;
      margin-bottom: 10px;
    }

    .hero .date {
      font-size: 1.2rem;
      color: var(--text-muted);
      letter-spacing: 2px;
      margin-bottom: 30px;
    }

    .btn {
      display: inline-block;
      padding: 12px 35px;
      background-color: var(--text-main);
      color: #fff;
      text-decoration: none;
      font-size: 0.85rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      border-radius: 2px;
      transition: background 0.3s ease;
      border: none;
      cursor: pointer;
    }

    .btn:hover {
      background-color: var(--accent);
    }

    /* Compte à rebours */
    .timer-container {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin: 40px 0;
    }

    .timer-box {
      background: var(--card-bg);
      border: 1px solid var(--border);
      padding: 15px;
      min-width: 80px;
      border-radius: 4px;
    }

    .timer-box span {
      display: block;
      font-size: 1.8rem;
      font-family: var(--font-title);
      color: var(--accent);
    }

    .timer-box label {
      font-size: 0.75rem;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    /* Photos */
    .photo-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 15px;
      margin-top: 30px;
    }

    .photo-grid img {
      width: 100%;
      height: 300px;
      object-fit: cover;
      border-radius: 4px;
    }

    /* Timeline Story */
    .timeline {
      position: relative;
      margin: 40px 0;
      text-align: left;
    }

    .timeline-item {
      padding: 20px 0 20px 30px;
      border-left: 1px solid var(--accent);
      position: relative;
      margin-left: 20px;
    }

    .timeline-item::before {
      content: '';
      position: absolute;
      left: -5px;
      top: 28px;
      width: 9px;
      height: 9px;
      background: var(--accent);
      border-radius: 50%;
    }

    .timeline-year {
      font-weight: 600;
      color: var(--accent);
      font-size: 0.9rem;
    }

    .timeline-title {
      font-family: var(--font-title);
      font-size: 1.4rem;
      margin: 5px 0;
    }

    /* FAQ Collapsible */
    .faq-item {
      background: var(--card-bg);
      border: 1px solid var(--border);
      margin-bottom: 10px;
      text-align: left;
      border-radius: 4px;
    }

    .faq-question {
      padding: 18px;
      cursor: pointer;
      font-weight: 500;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .faq-answer {
      padding: 0 18px 18px 18px;
      display: none;
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    /* Formulaire RSVP */
    .rsvp-form {
      background: var(--card-bg);
      padding: 40px 20px;
      border: 1px solid var(--border);
      border-radius: 4px;
      text-align: left;
      max-width: 600px;
      margin: 0 auto;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      margin-bottom: 8px;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 4px;
      font-family: inherit;
      background: var(--bg-color);
    }

    footer {
      padding: 30px;
      font-size: 0.8rem;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
    }
  </style>
</head>
<body>

  <!-- Hero Section -->
  <section class="hero">
    <h1>Prénom &amp; Prénom</h1>
    <div class="date">13 SEPTEMBRE 2026</div>
    <a href="#rsvp" class="btn">Confirmer ma présence</a>

    <!-- Compte à rebours -->
    <div class="timer-container">
      <div class="timer-box"><span id="days">00</span><label>Jours</label></div>
      <div class="timer-box"><span id="hours">00</span><label>Heures</label></div>
      <div class="timer-box"><span id="minutes">00</span><label>Min</label></div>
      <div class="timer-box"><span id="seconds">00</span><label>Sec</label></div>
    </div>
  </section>

  <!-- Galerie Photos -->
  <section>
    <h2>Nos Souvenirs</h2>
    <div class="photo-grid">
      <img src="[https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=600&q=80](https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=600&q=80)" alt="Couple 1">
      <img src="[https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=600&q=80](https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=600&q=80)" alt="Couple 2">
      <img src="[https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=600&q=80](https://images.unsplash.com/photo-1583939003579-730e3918a45a?auto=format&fit=crop&w=600&q=80)" alt="Couple 3">
    </div>
  </section>

  <!-- Notre Histoire -->
  <section>
    <h2>Notre Histoire</h2>
    <div class="timeline">
      <div class="timeline-item">
        <div class="timeline-year">2020</div>
        <div class="timeline-title">La Première Rencontre</div>
        <p>Un simple café qui s'est transformé en de longues heures de discussion.</p>
      </div>
      <div class="timeline-item">
        <div class="timeline-year">2023</div>
        <div class="timeline-title">Les Premiers Voyages</div>
        <p>Le début de nos aventures ensemble aux quatre coins du monde.</p>
      </div>
      <div class="timeline-item">
        <div class="timeline-year">2025</div>
        <div class="timeline-title">Le Grand "Oui"</div>
        <p>Une demande inoubliable au coucher du soleil.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <h2>Questions Fréquentes</h2>
    <div class="faq-item">
      <div class="faq-question">Quelle est la date limite pour répondre ? <span>+</span></div>
      <div class="faq-answer">Merci de nous confirmer votre présence avant le 30 juin 2026.</div>
    </div>
    <div class="faq-item">
      <div class="faq-question">Les enfants sont-ils invités ? <span>+</span></div>
      <div class="faq-answer">Afin de permettre à tous de profiter pleinement de la soirée, l'événement est réservé aux adultes.</div>
    </div>
    <div class="faq-item">
      <div class="faq-question">Y a-t-il un Dress Code ? <span>+</span></div>
      <div class="faq-answer">Tenue chic et élégante exigée. Les teintes neutres et monochromes sont à l'honneur !</div>
    </div>
  </section>

  <!-- Formulaire RSVP -->
  <section id="rsvp">
    <h2>Confirmer votre Présence</h2>
    <form class="rsvp-form" onsubmit="event.preventDefault(); alert('Merci ! Votre réponse a bien été prise en compte.');">
      <div class="form-group">
        <label for="name">Nom &amp; Prénom</label>
        <input type="text" id="name" required placeholder="Ex: Jean Dupont">
      </div>
      <div class="form-group">
        <label for="status">Serez-vous présent ?</label>
        <select id="status">
          <option value="yes">Oui, avec grand plaisir !</option>
          <option value="no">Désolé(e), je ne pourrai pas être présent(e)</option>
        </select>
      </div>
      <div class="form-group">
        <label for="guests">Nombre d'accompagnants (+1)</label>
        <input type="number" id="guests" min="0" max="5" value="0">
      </div>
      <div class="form-group">
        <label for="diet">Regime alimentaire ou allergies</label>
        <textarea id="diet" rows="3" placeholder="Végétarien, allergies, etc."></textarea>
      </div>
      <button type="submit" class="btn" style="width: 100%;">Envoyer</button>
    </form>
  </section>

  <footer>
    <p>Nous avons hâte de célébrer ce moment avec vous.</p>
  </footer>

  <script>
    // Compte à rebours
    const targetDate = new Date("September 13, 2026 15:00:00").getTime();

    function updateCountdown() {
      const now = new Date().getTime();
      const difference = targetDate - now;

      if (difference > 0) {
        document.getElementById("days").innerText = Math.floor(difference / (1000 * 60 * 60 * 24));
        document.getElementById("hours").innerText = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        document.getElementById("minutes").innerText = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
        document.getElementById("seconds").innerText = Math.floor((difference % (1000 * 60)) / 1000);
      }
    }
    setInterval(updateCountdown, 1000);
    updateCountdown();

    // Accordéon FAQ
    document.querySelectorAll('.faq-question').forEach(item => {
      item.addEventListener('click', () => {
        const answer = item.nextElementSibling;
        const icon = item.querySelector('span');
        if (answer.style.display === "block") {
          answer.style.display = "none";
          icon.innerText = "+";
        } else {
          answer.style.display = "block";
          icon.innerText = "-";
        }
      });
    });
  </script>
</body>
</html>
