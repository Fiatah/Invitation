<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Steve & Keren — Invitation de Mariage</title>
    <!-- Polices Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    
    <style>
        /* Variables de Style */
        :root {
            --bg-color: #FAFAFA;
            --text-color: #222222;
            --accent-color: #8C7A6B;
            --light-bg: #F3F0EC;
            --white: #FFFFFF;
            --font-title: 'Cormorant Garamond', serif;
            --font-body: 'Montserrat', sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-body);
            line-height: 1.6;
            text-align: center;
        }

        h1, h2, h3 {
            font-family: var(--font-title);
            font-weight: 400;
            letter-spacing: 1px;
        }

        /* En-tête (Hero) */
        header {
            padding: 100px 20px 60px;
            background-color: var(--bg-color);
        }

        header h1 {
            font-size: 3.5rem;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        header h1 span {
            font-family: var(--font-title);
            font-style: italic;
            font-weight: 300;
            text-transform: lowercase;
        }

        header .date {
            font-size: 1.2rem;
            letter-spacing: 3px;
            color: var(--accent-color);
            margin-bottom: 30px;
        }

        .btn-rsvp {
            display: inline-block;
            padding: 12px 35px;
            background-color: var(--text-color);
            color: var(--white);
            text-decoration: none;
            font-size: 0.85rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: background 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-rsvp:hover {
            background-color: var(--accent-color);
        }

        /* Galerie / Photos */
        .photo-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 15px;
            max-width: 1000px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .photo-grid img {
            width: 100%;
            height: 350px;
            object-fit: cover;
            filter: grayscale(20%);
            transition: filter 0.3s ease;
        }

        .photo-grid img:hover {
            filter: grayscale(0%);
        }

        /* Compte à rebours */
        .countdown-section {
            background-color: var(--light-bg);
            padding: 50px 20px;
            margin: 60px 0;
        }

        .timer {
            display: flex;
            justify-content: center;
            gap: 30px;
            margin-top: 20px;
        }

        .timer-box span {
            display: block;
            font-family: var(--font-title);
            font-size: 2.8rem;
            line-height: 1;
        }

        .timer-box label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--accent-color);
        }

        /* Timeline / Histoire */
        .section-container {
            max-width: 700px;
            margin: 80px auto;
            padding: 0 20px;
        }

        .section-title {
            font-size: 2.2rem;
            margin-bottom: 40px;
            position: relative;
        }

        .timeline-item {
            margin-bottom: 40px;
            text-align: left;
            border-left: 2px solid var(--light-bg);
            padding-left: 20px;
            position: relative;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -6px;
            top: 5px;
            width: 10px;
            height: 10px;
            background-color: var(--accent-color);
            border-radius: 50%;
        }

        .timeline-year {
            font-family: var(--font-title);
            font-size: 1.4rem;
            color: var(--accent-color);
        }

        .timeline-title {
            font-weight: 500;
            margin-bottom: 5px;
        }

        /* FAQ Accordion */
        .faq-item {
            border-bottom: 1px solid var(--light-bg);
            text-align: left;
            padding: 15px 0;
        }

        .faq-question {
            font-weight: 500;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            font-size: 0.9rem;
            color: #555;
            margin-top: 5px;
        }

        .faq-item.active .faq-answer {
            max-height: 200px;
            padding-top: 10px;
        }

        /* Formulaire RSVP */
        .rsvp-section {
            background-color: var(--light-bg);
            padding: 80px 20px;
        }

        form {
            max-width: 500px;
            margin: 30px auto 0;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        input, select, textarea {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #DDD;
            background: var(--white);
            font-family: var(--font-body);
            font-size: 0.9rem;
            outline: none;
        }

        /* Footer */
        footer {
            padding: 40px 20px;
            font-size: 0.8rem;
            color: #888;
        }

        @media (max-width: 600px) {
            header h1 { font-size: 2.5rem; }
            .timer { gap: 15px; }
            .timer-box span { font-size: 2rem; }
        }
    </style>
</head>
<body>

